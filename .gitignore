# Ignore the gfpgan directory and all its content
gfpgan/

# Ignore the specific model files
models/GFPGANv1.4.pth
models/inswapper_128_fp16.onnx

# Ignore all __pycache__ directories anywhere within the repo
**/__pycache__/

# Ignore the venv directory (virtual environment)
venv/

# Downloaded models and TensorRT engine cache
models/*.onnx
models/trt_cache/

# Your own virtual backgrounds (only the README is tracked)
backgrounds/*
!backgrounds/README.txt

# Auto-push watcher state
tools/auto_push.log
tools/auto_push.log.old
tools/auto_push.pid
.autopush-pause
